# ========================================
# SENSITIVE FILES - NEVER COMMIT THESE!
# ========================================

# Production environment files (contain secrets)
**/.env.production
**/.env.prod
**/.env.staging
**/secrets.json
**/credentials.json

# SSL/TLS Certificates and private keys
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt
**/*.pem
**/*.key
**/*.crt
!nginx/ssl/README.md

# OAuth secrets
**/client_secret*.json
**/oauth_credentials.json

# Database dumps and backups
*.sql
*.dump
*.bak
backups/

# ========================================
# FRONTEND
# ========================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.staging
frontend/*.local
frontend/.cache/
frontend/.vite/

