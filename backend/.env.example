# =============================================================================
# Face Recognition Attendance System — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# =============================================================================

# =============================================================================
# Django Core
# =============================================================================

# Secret key — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Use 50+ random characters. Must be kept secret in production.
SECRET_KEY=your-very-long-random-secret-key-here-50-plus-chars

# Debug mode — MUST be False in production
DEBUG=True

# Comma-separated list of allowed hostnames
# Production example: ALLOWED_HOSTS=api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# =============================================================================
# MongoDB Atlas
# =============================================================================

# Full connection string (include credentials in the URI, not separately)
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=...
# Get this from: Atlas → Connect → Drivers → Python
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Database name inside your Atlas cluster
MONGODB_DATABASE=face_attendance

# =============================================================================
# CORS — Origins the React frontend is served from
# =============================================================================
# Comma-separated list. In production, replace with your actual frontend domain.
# Example: CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# JWT Token Lifetimes
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# Face Recognition Thresholds
# See ML_ARCHITECTURE.md for full threshold guidance.
# Only adjust after evaluating recognition accuracy on your dataset.
# =============================================================================

# ── Spec-canonical thresholds (used by the recognition API) ──────────────────

# 1:1 Verification — "Is this image the same person as user X?"
# Range 0.0–1.0. Higher = stricter (fewer false accepts, more false rejects).
# Default 0.60 is calibrated for the InsightFace buffalo_l model.
FACE_VERIFICATION_THRESHOLD=0.60

# 1:N Identification — "Who is this person among all enrolled employees?"
# Slightly lower than verification threshold to improve recall in 1:N search.
FACE_IDENTIFICATION_THRESHOLD=0.55

# ── Legacy internal thresholds (used by older enrollment validation code) ─────
# These are separate from the recognition API thresholds above.
# FACE_RECOGNITION_THRESHOLD: minimum similarity to accept a face during
#   enrollment duplicate-check. Default 0.4 (lenient — avoids blocking
#   legitimate re-enrollment when lighting changes).
FACE_RECOGNITION_THRESHOLD=0.4

# FACE_DETECTION_CONFIDENCE: minimum InsightFace SCRFD detection score
#   required before extracting an embedding. Default 0.5.
#   The recognition API uses a stricter runtime check (0.85) internally.
FACE_DETECTION_CONFIDENCE=0.5

# =============================================================================
# Production-only security settings
# Uncomment and set these when DEBUG=False
# =============================================================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
