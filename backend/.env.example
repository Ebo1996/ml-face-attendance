# =====================================================================
# Django Settings
# =====================================================================
SECRET_KEY=your-secret-key-here-change-in-production-use-50+-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================================================
# MongoDB Configuration
# =====================================================================
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.g4aidzg.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=face_attendance

# =====================================================================
# JWT Settings
# =====================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =====================================================================
# Face Recognition Thresholds
# These values are documented in ML_ARCHITECTURE.md.
# Adjust only after evaluating recognition accuracy on your dataset.
# =====================================================================
FACE_RECOGNITION_THRESHOLD=0.4
FACE_DETECTION_CONFIDENCE=0.5
FACE_VERIFICATION_THRESHOLD=0.60
FACE_IDENTIFICATION_THRESHOLD=0.55

# =====================================================================
# CORS Settings
# In production, replace with your actual frontend domain.
# =====================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =====================================================================
# Production-only: set these when DEBUG=False
# =====================================================================
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
