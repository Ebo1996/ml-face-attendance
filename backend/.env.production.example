# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# IMPORTANT: Copy this file to .env.production and fill in real values
# NEVER commit .env.production to version control!

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=face_attendance_prod
# Set to False in production (Python 3.11 on server has no TLS issue)
TLS_ALLOW_INVALID_CERTS=False

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Rate Limiting (tightened for production)
THROTTLE_ANON=10/minute
THROTTLE_USER=60/minute
THROTTLE_AUTH=5/minute
THROTTLE_FACE=20/minute
FACE_DETECTION_CONFIDENCE=0.5
FACE_VERIFICATION_THRESHOLD=0.60
FACE_IDENTIFICATION_THRESHOLD=0.55

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Google OAuth (Production)
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret

# Email Configuration (Optional - for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Security Settings (Optional - advanced)
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
