# ================================================================
# Face Recognition Attendance System — Root Environment Example
# ================================================================
# Copy this file to .env (never commit the real .env)
# Each sub-directory also has its own .env.example:
#   backend/.env.example
#   frontend/.env.example
# ================================================================

# ── Backend ───────────────────────────────────────────────────────────

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=...
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Database name inside your Atlas cluster
MONGODB_DATABASE=face_attendance

# Django secret key — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# Debug mode — set False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — origins the React frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Face recognition thresholds (0.0 – 1.0)
# Higher = stricter matching
FACE_VERIFICATION_THRESHOLD=0.60
FACE_IDENTIFICATION_THRESHOLD=0.55

# ── Frontend ──────────────────────────────────────────────────────────

# Base URL of the Django API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api
