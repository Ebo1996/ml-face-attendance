# =============================================================================
# Face Recognition Attendance System — Root Environment Example
# =============================================================================
# This file documents ALL environment variables used across the project.
# Copy this file to .env (never commit the real .env to version control).
#
# Each sub-directory also has its own more detailed .env.example:
#   backend/.env.example   ← full backend variable reference
#   frontend/.env.example  ← frontend variable reference
# =============================================================================

# =============================================================================
# Backend — Django Core
# =============================================================================

# Django secret key (50+ random characters, keep secret in production)
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here-50-plus-chars

# Debug mode — set False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Backend — MongoDB Atlas
# =============================================================================

# Full Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=...
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Database name inside your Atlas cluster
MONGODB_DATABASE=face_attendance

# =============================================================================
# Backend — CORS
# =============================================================================

# Comma-separated list of origins the React frontend is served from
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Backend — JWT
# =============================================================================

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# Backend — Face Recognition Thresholds
# See backend/ML_ARCHITECTURE.md for full guidance before changing these.
# =============================================================================

# 1:1 verification threshold (0.0–1.0, default 0.60)
FACE_VERIFICATION_THRESHOLD=0.60

# 1:N identification threshold (0.0–1.0, default 0.55)
FACE_IDENTIFICATION_THRESHOLD=0.55

# Enrollment duplicate-check threshold (default 0.4)
FACE_RECOGNITION_THRESHOLD=0.4

# Minimum SCRFD detection confidence for enrollment (default 0.5)
FACE_DETECTION_CONFIDENCE=0.5

# =============================================================================
# Frontend — React / Vite
# =============================================================================

# Base URL of the Django API — no trailing slash
VITE_API_BASE_URL=http://localhost:8000/api
