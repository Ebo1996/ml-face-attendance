# ========================================
# PRODUCTION FRONTEND ENVIRONMENT
# ========================================
# IMPORTANT: Copy this file to .env.production and fill in real values
# NEVER commit .env.production with real credentials!

# API Base URL - Your production backend URL
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Google OAuth Client ID - Production credentials
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Analytics
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
