# =============================================================================
# API
# =============================================================================

# Base URL of the Django REST API — no trailing slash.
# Development default:
VITE_API_BASE_URL=http://localhost:8000/api

# Production example:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
